import re

from app import evaluate_summary, generate_summary


SOURCE_TEXT = (
    "Artificial intelligence is transforming healthcare by helping doctors analyze medical images, "
    "predict patient risk, and automate administrative work. Machine learning models can detect "
    "patterns in large datasets and assist clinicians in making more informed decisions. "
    "AI-powered tools are also improving patient support through chatbots and remote monitoring. "
    "While these systems create efficiency and better care, organizations must address privacy, bias, "
    "and transparency to build trust and deploy the technology responsibly."
)


def test_generate_summary_returns_human_readable_output():
    summary = generate_summary(SOURCE_TEXT, target_words=60)
    assert isinstance(summary, str)
    assert len(summary.strip()) > 20
    assert len(summary.split()) < 120
    assert bool(re.search(r"[A-Za-z]", summary))


def test_summary_quality_scores_are_in_range():
    summary = generate_summary(SOURCE_TEXT, target_words=60)
    metrics = evaluate_summary(SOURCE_TEXT, summary)
    for value in metrics.values():
        assert 0.0 <= value <= 1.0


def test_summary_contains_relevant_keywords():
    summary = generate_summary(SOURCE_TEXT, target_words=60)
    lower_summary = summary.lower()
    for expected in ["ai", "healthcare", "doctors", "patients", "technology"]:
        assert expected in lower_summary or expected.replace("-", "") in lower_summary

